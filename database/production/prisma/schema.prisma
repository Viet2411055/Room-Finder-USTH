// ==============================================================================
// RoomFinder Production Prisma Schema
// File: database/production/prisma/schema.prisma
// Engine: PostgreSQL (Compatible with Supabase, Neon, AWS RDS, Docker)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------

enum UserRole {
  traveler
  host
  admin

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING

  @@map("user_status")
}

enum ListingStatus {
  ACTIVE
  DRAFT
  INACTIVE

  @@map("listing_status")
}

enum BookingStatus {
  UPCOMING
  COMPLETED
  CANCELLED

  @@map("booking_status")
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED

  @@map("payment_status")
}

// ------------------------------------------------------------------------------
// Models
// ------------------------------------------------------------------------------

model User {
  id            String      @id @db.VarChar(64)
  email         String      @unique @db.VarChar(255)
  passwordHash  String      @map("password_hash") @db.VarChar(255)
  name          String      @db.VarChar(150)
  phone         String?     @db.VarChar(50)
  avatarUrl     String?     @map("avatar_url") @db.Text
  role          UserRole    @default(traveler)
  status        UserStatus  @default(ACTIVE)
  hostId        String?     @map("host_id") @db.VarChar(64)
  bio           String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  hostProfile   Host?       @relation("HostUserAccount")
  managedHost   Host?       @relation("HostIdentity", fields: [hostId], references: [id])
  bookings      Booking[]
  reviews       Review[]
  wishlists     Wishlist[]

  @@map("users")
}

model Host {
  id               String       @id @db.VarChar(64)
  userId           String?      @unique @map("user_id") @db.VarChar(64)
  name             String       @db.VarChar(150)
  email            String?      @db.VarChar(255)
  phone            String?      @db.VarChar(50)
  avatarUrl        String       @map("avatar_url") @db.Text
  about            String?      @db.Text
  isSuperhost      Boolean      @default(false) @map("is_superhost")
  responseRate     String       @default("100%") @map("response_rate") @db.VarChar(20)
  responseTime     String       @default("trong vòng 1 giờ") @map("response_time") @db.VarChar(50)
  joinedDate       String       @map("joined_date") @db.VarChar(50)
  identityVerified Boolean      @default(true) @map("identity_verified")
  listingsCount    Int          @default(0) @map("listings_count")
  rating           Decimal      @default(5.0) @db.Decimal(3, 2)
  reviewCount      Int          @default(0) @map("review_count")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  userAccount      User?        @relation("HostUserAccount", fields: [userId], references: [id])
  usersWithHostId  User[]       @relation("HostIdentity")
  listings         Listing[]
  bookings         Booking[]

  @@map("hosts")
}

model City {
  id          String     @id @db.VarChar(64)
  name        String     @db.VarChar(100)
  slug        String     @unique @db.VarChar(100)
  country     String     @default("Việt Nam") @db.VarChar(50)
  latitude    Decimal    @db.Decimal(10, 7)
  longitude   Decimal    @db.Decimal(10, 7)
  imageUrl    String?    @map("image_url") @db.Text
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  districts   District[]
  listings    Listing[]

  @@map("cities")
}

model District {
  id        String    @id @db.VarChar(64)
  cityId    String    @map("city_id") @db.VarChar(64)
  name      String    @db.VarChar(100)
  slug      String    @db.VarChar(100)
  latitude  Decimal?  @db.Decimal(10, 7)
  longitude Decimal?  @db.Decimal(10, 7)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  listings  Listing[]

  @@unique([cityId, name])
  @@map("districts")
}

model AmenityCategory {
  id           String    @id @db.VarChar(64)
  name         String    @db.VarChar(100)
  icon         String?   @db.VarChar(50)
  displayOrder Int       @default(0) @map("display_order")

  // Relations
  amenities    Amenity[]

  @@map("amenity_categories")
}

model Amenity {
  id               String            @id @db.VarChar(64)
  categoryId       String?           @map("category_id") @db.VarChar(64)
  name             String            @db.VarChar(150)
  code             String            @unique @db.VarChar(100)
  icon             String?           @db.VarChar(50)

  // Relations
  category         AmenityCategory?  @relation(fields: [categoryId], references: [id])
  listingAmenities ListingAmenity[]

  @@map("amenities")
}

model Listing {
  id                           String          @id @db.VarChar(64)
  hostId                       String          @map("host_id") @db.VarChar(64)
  cityId                       String?         @map("city_id") @db.VarChar(64)
  districtId                   String?         @map("district_id") @db.VarChar(64)
  listingUrl                   String?         @map("listing_url") @db.Text
  name                         String          @db.VarChar(255)
  roomType                     String          @map("room_type") @db.VarChar(100)
  city                         String          @db.VarChar(100)
  district                     String          @db.VarChar(100)
  neighborhood                 String?         @db.VarChar(100)
  address                      String          @db.Text
  latitude                     Decimal         @db.Decimal(10, 7)
  longitude                    Decimal         @db.Decimal(10, 7)
  pricePerNight                Int             @map("price_per_night")
  priceFormatted               String          @map("price_formatted") @db.VarChar(100)
  priceTotal                   Int?            @map("price_total")
  priceNights                  Int?            @map("price_nights")
  priceLabel                   String?         @map("price_label") @db.VarChar(100)
  cleaningFee                  Int             @default(120000) @map("cleaning_fee")
  serviceFeeRate               Decimal         @default(0.08) @map("service_fee_rate") @db.Decimal(4, 2)
  guestsMax                    Int             @default(2) @map("guests_max")
  bedrooms                     Int             @default(1)
  beds                         Int             @default(1)
  baths                        Decimal         @default(1.0) @db.Decimal(3, 1)
  description                  String          @db.Text
  rating                       Decimal         @default(0.0) @db.Decimal(3, 2)
  reviewCount                  Int             @default(0) @map("review_count")
  isSuperhost                  Boolean         @default(false) @map("is_superhost")
  isGuestFavorite              Boolean         @default(false) @map("is_guest_favorite")
  coverImage                   String          @map("cover_image") @db.Text
  imageCount                   Int             @default(0) @map("image_count")
  houseRules                   Json            @default("[]") @map("house_rules")
  cancellationPolicyTitle       String          @default("Hủy miễn phí trong 48 giờ") @map("cancellation_policy_title") @db.VarChar(150)
  cancellationPolicyDescription String          @default("Hoàn tiền 100% nếu hủy trước ngày nhận phòng ít nhất 48 giờ.") @map("cancellation_policy_description") @db.Text
  status                       ListingStatus   @default(ACTIVE)
  createdAt                    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  host                         Host            @relation(fields: [hostId], references: [id], onDelete: Cascade)
  cityRel                      City?           @relation(fields: [cityId], references: [id])
  districtRel                  District?       @relation(fields: [districtId], references: [id])
  images                       ListingImage[]
  amenities                    ListingAmenity[]
  calendar                     ListingCalendar[]
  bookings                     Booking[]
  reviews                      Review[]
  wishlists                    Wishlist[]

  @@index([hostId])
  @@index([city, status, pricePerNight])
  @@index([district])
  @@index([rating(sort: Desc)])
  @@map("listings")
}

model ListingImage {
  id           String    @id @db.VarChar(64)
  listingId    String    @map("listing_id") @db.VarChar(64)
  imageUrl     String    @map("image_url") @db.Text
  displayOrder Int       @default(0) @map("display_order")
  isCover      Boolean   @default(false) @map("is_cover")
  caption      String?   @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  listing      Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, displayOrder])
  @@map("listing_images")
}

model ListingAmenity {
  listingId   String   @map("listing_id") @db.VarChar(64)
  amenityId   String?  @map("amenity_id") @db.VarChar(64)
  amenityName String   @map("amenity_name") @db.VarChar(150)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity     Amenity? @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityName])
  @@map("listing_amenities")
}

model ListingCalendar {
  id            String    @id @db.VarChar(64)
  listingId     String    @map("listing_id") @db.VarChar(64)
  bookingId     String?   @map("booking_id") @db.VarChar(64)
  checkIn       DateTime  @map("check_in") @db.Date
  checkOut      DateTime  @map("check_out") @db.Date
  isBlocked     Boolean   @default(true) @map("is_blocked")
  priceOverride Int?      @map("price_override")
  note          String?   @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booking       Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([listingId, checkIn, checkOut])
  @@map("listing_calendar")
}

model Booking {
  id              String        @id @db.VarChar(64)
  bookingCode     String        @unique @map("booking_code") @db.VarChar(50)
  userId          String        @map("user_id") @db.VarChar(64)
  listingId       String        @map("listing_id") @db.VarChar(64)
  hostId          String        @map("host_id") @db.VarChar(64)
  guestName       String        @map("guest_name") @db.VarChar(150)
  guestEmail      String        @map("guest_email") @db.VarChar(150)
  guestPhone      String        @map("guest_phone") @db.VarChar(50)
  listingName     String        @map("listing_name") @db.VarChar(255)
  city            String        @db.VarChar(100)
  district        String        @db.VarChar(100)
  coverImage      String        @map("cover_image") @db.Text
  hostName        String        @map("host_name") @db.VarChar(150)
  checkIn         DateTime      @map("check_in") @db.Date
  checkOut        DateTime      @map("check_out") @db.Date
  nights          Int
  guests          Int
  pricePerNight   Int           @map("price_per_night")
  cleaningFee     Int           @default(0) @map("cleaning_fee")
  serviceFee      Int           @default(0) @map("service_fee")
  totalPrice      Int           @map("total_price")
  status          BookingStatus @default(UPCOMING)
  paymentMethod   String        @map("payment_method") @db.VarChar(100)
  paymentStatus   PaymentStatus @default(PAID) @map("payment_status")
  specialRequests String?       @map("special_requests") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing         Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  host            Host          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  calendarEntries ListingCalendar[]
  reviews         Review[]

  @@index([userId, status])
  @@index([hostId, status])
  @@map("bookings")
}

model Review {
  id             String    @id @db.VarChar(64)
  listingId      String    @map("listing_id") @db.VarChar(64)
  bookingId      String?   @map("booking_id") @db.VarChar(64)
  userId         String?   @map("user_id") @db.VarChar(64)
  reviewerName   String    @map("reviewer_name") @db.VarChar(150)
  reviewerAvatar String?   @map("reviewer_avatar") @db.Text
  rating         Decimal   @db.Decimal(2, 1)
  comment        String    @db.Text
  hostReply      String?   @map("host_reply") @db.Text
  hostReplyDate  DateTime? @map("host_reply_date") @db.Timestamptz
  reviewDate     String    @map("review_date") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booking        Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([rating(sort: Desc)])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  listingId String   @map("listing_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("wishlists")
}
