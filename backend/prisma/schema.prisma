generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAVELER
  HOST
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EmailOutboxType {
  BOOKING_CONFIRMATION
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id              String     @id @default(uuid()) @db.VarChar(64)
  username        String     @unique @db.VarChar(50)
  email           String     @unique @db.VarChar(255)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  name            String     @db.VarChar(150)
  phone           String?    @db.VarChar(50)
  avatarUrl       String?    @map("avatar_url") @db.Text
  role            Role       @default(TRAVELER)
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  bio             String?    @db.Text
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  hostProfile     Host?
  bookings        Booking[]
  reviews         Review[]
  wishlists       Wishlist[]
  otpTokens       OtpToken[]
  sessions        Session[]

  @@map("users")
}

model Host {
  id               String    @id @default(uuid()) @db.VarChar(64)
  userId           String    @unique @map("user_id") @db.VarChar(64)
  name             String    @db.VarChar(150)
  email            String?   @db.VarChar(255)
  phone            String?   @db.VarChar(50)
  avatarUrl        String?   @map("avatar_url") @db.Text
  about            String?   @db.Text
  isSuperhost      Boolean   @default(false) @map("is_superhost")
  responseRate     String    @default("100%") @map("response_rate") @db.VarChar(20)
  responseTime     String    @default("trong vòng 1 giờ") @map("response_time") @db.VarChar(50)
  joinedDate       String    @map("joined_date") @db.VarChar(50)
  identityVerified Boolean   @default(false) @map("identity_verified")
  listingsCount    Int       @default(0) @map("listings_count")
  rating           Decimal   @default(5.0) @db.Decimal(3, 2)
  reviewCount      Int       @default(0) @map("review_count")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings         Listing[]
  bookings         Booking[]

  @@map("hosts")
}

model City {
  id        String     @id @db.VarChar(64)
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(100)
  country   String     @default("Việt Nam") @db.VarChar(50)
  latitude  Decimal    @db.Decimal(10, 7)
  longitude Decimal    @db.Decimal(10, 7)
  imageUrl  String?    @map("image_url") @db.Text
  createdAt DateTime   @default(now()) @map("created_at")
  districts District[]
  listings  Listing[]

  @@map("cities")
}

model District {
  id        String    @id @db.VarChar(64)
  cityId    String    @map("city_id") @db.VarChar(64)
  name      String    @db.VarChar(100)
  slug      String    @db.VarChar(100)
  latitude  Decimal?  @db.Decimal(10, 7)
  longitude Decimal?  @db.Decimal(10, 7)
  createdAt DateTime  @default(now()) @map("created_at")
  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  listings  Listing[]

  @@unique([cityId, name])
  @@map("districts")
}

model AmenityCategory {
  id           String    @id @db.VarChar(64)
  name         String    @db.VarChar(100)
  icon         String?   @db.VarChar(50)
  displayOrder Int       @default(0) @map("display_order")
  amenities    Amenity[]

  @@map("amenity_categories")
}

model Amenity {
  id               String           @id @db.VarChar(64)
  categoryId       String?          @map("category_id") @db.VarChar(64)
  name             String           @db.VarChar(150)
  code             String           @unique @db.VarChar(100)
  icon             String?          @db.VarChar(50)
  category         AmenityCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  listingAmenities ListingAmenity[]

  @@map("amenities")
}

model Listing {
  id                            String            @id @default(uuid()) @db.VarChar(64)
  hostId                        String            @map("host_id") @db.VarChar(64)
  cityId                        String?           @map("city_id") @db.VarChar(64)
  districtId                    String?           @map("district_id") @db.VarChar(64)
  listingUrl                    String?           @map("listing_url") @db.Text
  name                          String            @db.VarChar(255)
  roomType                      String            @map("room_type") @db.VarChar(100)
  city                          String            @db.VarChar(100)
  district                      String            @db.VarChar(100)
  neighborhood                  String?           @db.VarChar(100)
  address                       String            @db.Text
  latitude                      Decimal           @db.Decimal(10, 7)
  longitude                     Decimal           @db.Decimal(10, 7)
  pricePerNight                 Int               @map("price_per_night")
  priceFormatted                String            @map("price_formatted") @db.VarChar(100)
  cleaningFee                   Int               @default(120000) @map("cleaning_fee")
  serviceFeeRate                Decimal           @default(0.08) @map("service_fee_rate") @db.Decimal(4, 2)
  guestsMax                     Int               @default(2) @map("guests_max")
  bedrooms                      Int               @default(1)
  beds                          Int               @default(1)
  baths                         Decimal           @default(1) @db.Decimal(3, 1)
  description                   String            @db.Text
  rating                        Decimal           @default(0) @db.Decimal(3, 2)
  reviewCount                   Int               @default(0) @map("review_count")
  isSuperhost                   Boolean           @default(false) @map("is_superhost")
  isGuestFavorite               Boolean           @default(false) @map("is_guest_favorite")
  coverImage                    String            @map("cover_image") @db.Text
  imageCount                    Int               @default(0) @map("image_count")
  houseRules                    Json              @map("house_rules")
  cancellationPolicyTitle       String            @map("cancellation_policy_title") @db.VarChar(150)
  cancellationPolicyDescription String            @map("cancellation_policy_description") @db.Text
  status                        ListingStatus     @default(DRAFT)
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")
  host                          Host              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  cityRel                       City?             @relation(fields: [cityId], references: [id], onDelete: SetNull)
  districtRel                   District?         @relation(fields: [districtId], references: [id], onDelete: SetNull)
  images                        ListingImage[]
  amenities                     ListingAmenity[]
  calendar                      ListingCalendar[]
  bookings                      Booking[]
  reviews                       Review[]
  wishlists                     Wishlist[]

  @@index([city, status, pricePerNight])
  @@index([hostId])
  @@map("listings")
}

model ListingImage {
  id           String  @id @default(uuid()) @db.VarChar(64)
  listingId    String  @map("listing_id") @db.VarChar(64)
  imageUrl     String  @map("image_url") @db.Text
  displayOrder Int     @default(0) @map("display_order")
  isCover      Boolean @default(false) @map("is_cover")
  caption      String? @db.VarChar(255)
  listing      Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, displayOrder])
  @@map("listing_images")
}

model ListingAmenity {
  listingId   String   @map("listing_id") @db.VarChar(64)
  amenityId   String?  @map("amenity_id") @db.VarChar(64)
  amenityName String   @map("amenity_name") @db.VarChar(150)
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity     Amenity? @relation(fields: [amenityId], references: [id], onDelete: SetNull)

  @@id([listingId, amenityName])
  @@map("listing_amenities")
}

model Booking {
  id              String            @id @default(uuid()) @db.VarChar(64)
  bookingCode     String            @unique @map("booking_code") @db.VarChar(50)
  idempotencyKey  String?           @unique @map("idempotency_key") @db.VarChar(100)
  userId          String            @map("user_id") @db.VarChar(64)
  listingId       String            @map("listing_id") @db.VarChar(64)
  hostId          String            @map("host_id") @db.VarChar(64)
  guestName       String            @map("guest_name") @db.VarChar(150)
  guestEmail      String            @map("guest_email") @db.VarChar(150)
  guestPhone      String            @map("guest_phone") @db.VarChar(50)
  listingName     String            @map("listing_name") @db.VarChar(255)
  city            String            @db.VarChar(100)
  district        String            @db.VarChar(100)
  coverImage      String            @map("cover_image") @db.Text
  hostName        String            @map("host_name") @db.VarChar(150)
  checkIn         DateTime          @map("check_in") @db.Date
  checkOut        DateTime          @map("check_out") @db.Date
  nights          Int
  guests          Int
  pricePerNight   Int               @map("price_per_night")
  cleaningFee     Int               @map("cleaning_fee")
  serviceFee      Int               @map("service_fee")
  totalPrice      Int               @map("total_price")
  status          BookingStatus     @default(UPCOMING)
  paymentMethod   String            @map("payment_method") @db.VarChar(100)
  paymentStatus   PaymentStatus     @default(PAID) @map("payment_status")
  specialRequests String?           @map("special_requests") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing         Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  host            Host              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  calendarEntries ListingCalendar[]
  reviews         Review[]

  @@index([userId, status])
  @@index([hostId, status])
  @@index([listingId, checkIn, checkOut])
  @@map("bookings")
}

model ListingCalendar {
  id            String   @id @default(uuid()) @db.VarChar(64)
  listingId     String   @map("listing_id") @db.VarChar(64)
  bookingId     String?  @map("booking_id") @db.VarChar(64)
  checkIn       DateTime @map("check_in") @db.Date
  checkOut      DateTime @map("check_out") @db.Date
  isBlocked     Boolean  @default(true) @map("is_blocked")
  priceOverride Int?     @map("price_override")
  note          String?  @db.VarChar(255)
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booking       Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([listingId, checkIn, checkOut])
  @@map("listing_calendar")
}

model Review {
  id             String    @id @default(uuid()) @db.VarChar(64)
  listingId      String    @map("listing_id") @db.VarChar(64)
  bookingId      String?   @unique @map("booking_id") @db.VarChar(64)
  userId         String?   @map("user_id") @db.VarChar(64)
  reviewerName   String    @map("reviewer_name") @db.VarChar(150)
  reviewerAvatar String?   @map("reviewer_avatar") @db.Text
  rating         Decimal   @db.Decimal(2, 1)
  comment        String    @db.Text
  hostReply      String?   @map("host_reply") @db.Text
  hostReplyDate  DateTime? @map("host_reply_date")
  reviewDate     String    @map("review_date") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booking        Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  listingId String   @map("listing_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("wishlists")
}

model OtpToken {
  id         String     @id @default(uuid()) @db.VarChar(64)
  userId     String     @map("user_id") @db.VarChar(64)
  purpose    OtpPurpose
  codeHash   String     @map("code_hash") @db.VarChar(255)
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("otp_tokens")
}

model Session {
  id        String    @id @default(uuid()) @db.VarChar(64)
  userId    String    @map("user_id") @db.VarChar(64)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailOutbox {
  id          String            @id @default(uuid()) @db.VarChar(64)
  type        EmailOutboxType
  recipient   String            @db.VarChar(255)
  payload     Json
  dedupeKey   String            @unique @map("dedupe_key") @db.VarChar(190)
  status      EmailOutboxStatus @default(PENDING)
  attempts    Int               @default(0)
  availableAt DateTime          @default(now()) @map("available_at")
  lockedAt    DateTime?         @map("locked_at")
  sentAt      DateTime?         @map("sent_at")
  lastError   String?           @map("last_error") @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@map("email_outbox")
}
